<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>{{ movie.title }} sort aujourd'hui</title>
  </head>
  <body style="margin: 0; padding: 24px; background: #f5f5f5; font-family: Arial, sans-serif; color: #1a1a1a;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px; margin: 0 auto; background: #ffffff; border: 1px solid #e5e5e5;">
      @if(movie.backdropUrl)
        <tr>
          <td>
            <img src="{{ movie.backdropUrl }}" alt="" width="560" style="display: block; width: 100%; height: auto;" />
          </td>
        </tr>
      @end
      <tr>
        <td style="padding: 32px;">
          <p style="margin: 0 0 8px; font-size: 14px; color: #6b6b6b;">
            {{ brandName }} · Alerte de sortie
          </p>
          <h1 style="margin: 0 0 16px; font-size: 24px;">
            {{ movie.title }} sort aujourd'hui
          </h1>
          <p style="margin: 0 0 16px; line-height: 1.5;">
            Bonjour{{ user.firstName ? ' ' + user.firstName : '' }},
          </p>
          <p style="margin: 0 0 24px; line-height: 1.5;">
            Vous suiviez <strong>{{ movie.title }}</strong> : le film sort en salle aujourd'hui.
          </p>
          @if(movie.overview)
            <p style="margin: 0 0 24px; line-height: 1.5; color: #4a4a4a;">
              {{ movie.overview }}
            </p>
          @end
          <a href="{{ movieUrl }}" style="display: inline-block; padding: 12px 20px; background: #1a1a1a; color: #ffffff; text-decoration: none; font-weight: bold;">
            Voir la fiche du film
          </a>
        </td>
      </tr>
    </table>
  </body>
</html>
